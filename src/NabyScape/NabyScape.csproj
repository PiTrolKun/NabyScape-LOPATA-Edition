<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\lopata-island.ico</ApplicationIcon>
    <AssemblyName>LopataIsland</AssemblyName>
    <RootNamespace>NabyScape</RootNamespace>
    <Version>2.27.0</Version>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <Title>NabyScape — LOPATA Edition</Title>
    <Product>NabyScape — LOPATA Edition</Product>
    <Company>NabyScape</Company>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/PiTrolKun/NabyScape-LOPATA-Edition</RepositoryUrl>
    <!-- WPF owns DPI awareness; WinForms is used only for Screen and NotifyIcon. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <StartupObject>NabyScape.App</StartupObject>
  </PropertyGroup>
  <Target Name="RequireLopataCheckout" BeforeTargets="PrepareForBuild"
          Condition="!Exists('$(LopataRepositoryRoot)\Исходники\LOPATA.Collection\LOPATA.Collection.csproj')">
    <Error Text="Set LopataRepositoryRoot to the LOPATA checkout. See the LOPATA Edition build instructions." />
  </Target>
  <ItemGroup>
    <ProjectReference Include="$(LopataRepositoryRoot)\Исходники\LOPATA.Collection\LOPATA.Collection.csproj" />
    <ProjectReference Include="$(LopataRepositoryRoot)\Исходники\LOPATA.Updates\LOPATA.Updates.csproj" />
    <ProjectReference Include="$(LopataRepositoryRoot)\Исходники\LOPATA.Inspector\LOPATA.Inspector.csproj" />
    <EmbeddedResource Include="$(LopataRepositoryRoot)\Исходники\AIHub\Localization\ru.json" LogicalName="NabyScape.LopataRussian.json" />
    <Resource Include="$(LopataRepositoryRoot)\Исходники\AIHub\Assets\logo_crt_black_hole_matrix_tight_transparent_1x1.png"
              Link="Assets\lopata-mascot.png" />
    <Compile Include="$(LopataRepositoryRoot)\Исходники\AIHub\Services\Island\IslandLink.cs" Link="Application\IslandLink.cs" />
    <Compile Include="$(LopataRepositoryRoot)\Исходники\AIHub\Services\Island\IslandVoiceCommands.cs" Link="Features\Media\IslandVoiceCommands.cs" />
    <Compile Include="$(LopataRepositoryRoot)\Исходники\AIHub\Services\Island\IslandVoiceQuery.cs" Link="Features\Media\IslandVoiceQuery.cs" />
    <Compile Include="$(LopataRepositoryRoot)\Исходники\AIHub\Services\Island\IslandVoiceProtocol.cs" Link="Features\Media\IslandVoiceProtocol.cs" />
    <Compile Include="$(LopataRepositoryRoot)\Исходники\AIHub\Services\MailHub\MailHubFiles.cs" Link="Application\MailHubFiles.cs" />
    <Compile Include="$(LopataRepositoryRoot)\Исходники\AIHub\Controls\MailHub\MailHubPlayback.cs" Link="UI\Island\MailHubPlayback.cs" />
    <EmbeddedResource Include="$(LopataRepositoryRoot)\Исходники\AIHub\Localization\en.json" LogicalName="NabyScape.LopataEnglish.json" />
    <EmbeddedResource Include="$(LopataRepositoryRoot)\Исходники\AIHub\Assets\IslandVoice\lopata-na-svyazi-ru.wav" LogicalName="NabyScape.IslandReady.ru.wav" />
    <EmbeddedResource Include="$(LopataRepositoryRoot)\Исходники\AIHub\Assets\IslandVoice\lopata-here-go-ahead-en.wav" LogicalName="NabyScape.IslandReady.en.wav" />
    <PackageReference Include="System.Management" Version="10.0.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Lucene.Net.Analysis.Kuromoji" Version="4.8.0-beta00018" />
    <PackageReference Include="NTextCat" Version="0.3.65" />
    <Resource Include="Assets\island.ico" />
    <Resource Include="Assets\lopata-island.ico" />
    <Resource Include="Assets\naby-chrome.png" />
    <Resource Include="Assets\Fonts\Manrope-Medium.ttf" />
    <Resource Include="Assets\Fonts\Manrope-SemiBold.ttf" />
    <Resource Include="Assets\Fonts\Manrope-Bold.ttf" />
    <EmbeddedResource Include="..\..\docs\presets\default-preferences.json" LogicalName="NabyScape.DefaultPreferences.json" />
    <EmbeddedResource Include="..\..\docs\presets\default-layout.json" LogicalName="NabyScape.DefaultLayout.json" />
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="NabyScape.LICENSE" />
    <EmbeddedResource Include="..\..\licenses\NAudio-LICENSE.txt" LogicalName="NabyScape.NAudio-LICENSE.txt" />
    <EmbeddedResource Include="..\..\licenses\LUCIDE-LICENSE.txt" LogicalName="NabyScape.LUCIDE-LICENSE.txt" />
    <EmbeddedResource Include="..\..\licenses\MANROPE-OFL.txt" LogicalName="NabyScape.MANROPE-OFL.txt" />
    <EmbeddedResource Include="..\..\licenses\DOTNET-LICENSE.txt" LogicalName="NabyScape.DOTNET-LICENSE.txt" />
    <EmbeddedResource Include="..\..\licenses\DOTNET-ThirdPartyNotices.txt" LogicalName="NabyScape.DOTNET-ThirdPartyNotices.txt" />
    <EmbeddedResource Include="..\..\licenses\ROMAJI-ThirdPartyNotices.txt" LogicalName="NabyScape.ROMAJI-ThirdPartyNotices.txt" />
    <EmbeddedResource Include="..\..\licenses\LYRICS-LANGUAGE-LICENSE.txt" LogicalName="NabyScape.LYRICS-LANGUAGE-LICENSE.txt" />
    <EmbeddedResource Include="Assets\lyrics-languages.profile.xml.gz" LogicalName="NabyScape.LyricsLanguages" />
  </ItemGroup>
</Project>
